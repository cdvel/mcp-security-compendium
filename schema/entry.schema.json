{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compendium entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "url", "author", "author_kind", "published", "added", "last_verified",
               "source_type", "section", "kind", "signals", "description"],
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "url": {"type": "string", "pattern": "^https://"},
    "author": {"type": "string"},
    "author_url": {"type": "string", "pattern": "^https://"},
    "org": {"type": "string"},
    "author_kind": {"enum": ["research_lab", "vendor_lab", "academic", "standards_body",
                             "project_maintainers", "independent"]},
    "published": {"type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"},
    "added": {"type": "string", "format": "date"},
    "last_verified": {"type": "string", "format": "date"},
    "source_type": {"enum": ["primary", "secondary"]},
    "section": {"enum": ["specification_and_authorization", "clients_and_hosts", "servers",
                         "gateways_and_proxies", "registries_and_supply_chain",
                         "research", "incidents"]},
    "kind": {"enum": ["spec", "guide", "taxonomy", "paper", "writeup", "tool", "advisory", "dataset"]},
    "start_here": {"type": "boolean"},
    "signals": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["research_lab", "standards_body", "spec_maintainers", "cve", "paper",
                         "paper_with_code", "stars", "contributors", "active", "cited_by_strong",
                         "docs", "security_policy"]}
    },
    "threats": {
      "description": "CoSAI MCP threat categories (MCP-T1 to MCP-T12) as cross-reference tags.",
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8", "T9", "T10", "T11", "T12"]}
    },
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.+-]+$"}},
    "sources": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
    "description": {"type": "string", "minLength": 10, "maxLength": 240, "pattern": "\\.$"},
    "stars": {"type": "integer", "description": "bot-maintained"},
    "contributors": {"type": "integer", "description": "bot-maintained"},
    "pushed_at": {"type": "string", "description": "bot-maintained"},
    "archived": {"type": "boolean", "description": "bot-maintained"},
    "license": {"type": "string", "description": "bot-maintained"}
  }
}
